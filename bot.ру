def get_language_kb():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🇷🇺 Русский", callback_data="lang_ru")],
        [InlineKeyboardButton(text="🇺🇿 O'zbekcha", callback_data="lang_uz")],
        [InlineKeyboardButton(text="🇬🇧 English", callback_data="lang_en")]
    ])

def get_main_menu(lang):
    t = TEXTS[lang]
    return ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text=t['buy_btn'])],
            [KeyboardButton(text=t['support_btn']), KeyboardButton(text=t['lang_btn'])]
        ],
        resize_keyboard=True
    )

def get_gold_kb():
    buttons = []
    for gold, price in GOLD_PRICES.items():
        buttons.append([InlineKeyboardButton(
            text=f"🪙 {gold} Gold — {price:,} сум", 
            callback_data=f"buy_{gold}"
        )])
    return InlineKeyboardMarkup(inline_keyboard=buttons)

@dp.message(CommandStart())
async def cmd_start(message: Message):
    await message.answer(
        "Please select your language / Выберите язык / Tilni tanlang:",
        reply_markup=get_language_kb()
    )

@dp.callback_query(F.data.startswith("lang_"))
async def set_language(callback: CallbackQuery):
    lang = callback.data.split("_")[1]
    user_data[callback.from_user.id] = {'lang': lang}
    
    await callback.answer()
    await callback.message.delete()
    await callback.message.answer(
        TEXTS[lang]['welcome'],
        reply_markup=get_main_menu(lang)
    )

@dp.message(F.text == "🌐 Сменить язык / Language")
async def change_lang(message: Message):
    await message.answer(
        "Please select your language / Выберите язык / Tilni tanlang:",
        reply_markup=get_language_kb()
    )

@dp.message(F.text.in_(["💬 Техподдержка", "💬 Qo'llab-quvvatlash", "💬 Support"]))
async def show_support(message: Message):
    lang = user_data.get(message.from_user.id, {}).get('lang', 'ru')
    await message.answer(TEXTS[lang]['support_info'])

@dp.message(F.text.in_(["🪙 Купить голду", "🪙 Gold sotib olish", "🪙 Buy Gold"]))
async def select_gold(message: Message):
    lang = user_data.get(message.from_user.id, {}).get('lang', 'ru')
    await message.answer(
        TEXTS[lang]['select_gold'],
        reply_markup=get_gold_kb()
    )

@dp.callback_query(F.data.startswith("buy_"))
async def process_buy(callback: CallbackQuery):
    gold = int(callback.data.split("_")[1])
    price = GOLD_PRICES[gold]
    user_id = callback.from_user.id
    
    if user_id not in user_data:
        user_data[user_id] = {'lang': 'ru'}
    
    user_data[user_id]['selected_gold'] = gold
    lang = user_data[user_id]['lang']
    
    text = TEXTS[lang]['payment_info'].format(
        card=CARD_NUMBER,
        holder=CARD_HOLDER,
        price=price,
        gold=gold
    )
    
    await callback.answer()
    await callback.message.answer(text, parse_mode="Markdown")

@dp.message(F.photo | F.document)
async def forward_order_to_admin(message: Message):
    user_id = message.from_user.id
    user_info = user_data.get(user_id, {})
    gold = user_info.get('selected_gold', 'Не выбрано')
    lang = user_info.get('lang', 'ru')

    username = f"@{message.from_user.username}" if message.from_user.username else "Нет юзернейма"
    
    admin_text = (
        f"📥 **НОВЫЙ ЗАКАЗ!**\n\n"
        f"👤 Покупатель: {message.from_user.full_name} ({username})\n"
        f"🆔 ID: `{user_id}`\n"
        f"🪙 Выбранный пакет: **{gold} Gold**\n"
    )

    await bot.send_message(chat_id=ADMIN_ID, text=admin_text, parse_mode="Markdown")
    await message.forward(chat_id=ADMIN_ID)

    await message.answer(TEXTS[lang]['order_sent'])

